{
  "info": {
    "name": "CCE Collector Service",
    "description": "Postman collection for the CCE Collector Service — the event ingestion gateway of the Care Coordination Engine.\n\nBase URL: http://localhost:8080\n\nThe Collector receives CloudEvents v1.0 envelopes with FHIR R4 payloads, validates, normalizes, and publishes them to Kafka.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "patientUpid",
      "value": "260225-0002-5501",
      "type": "string"
    },
    {
      "key": "facilityId",
      "value": "0002",
      "type": "string"
    },
    {
      "key": "deadLetterId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Event Ingestion",
      "description": "POST /v1/events — Ingest clinical events via CloudEvents v1.0 envelopes.",
      "item": [
        {
          "name": "Ingest Encounter (Visit Registration)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/events",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "events"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"specversion\": \"1.0\",\n  \"id\": \"evt-eb010001-0001-4000-8000-000000000001\",\n  \"source\": \"rhie-mediator\",\n  \"type\": \"org.openphc.cce.encounter\",\n  \"subject\": \"{{patientUpid}}\",\n  \"time\": \"2026-02-25T08:00:00Z\",\n  \"datacontenttype\": \"application/fhir+json\",\n  \"facilityid\": \"{{facilityId}}\",\n  \"sourceeventid\": \"enc-visit-20260225-0001\",\n  \"correlationid\": \"corr-1343872c-636d-506f-b041-1e571d426932\",\n  \"data\": {\n    \"resourceType\": \"Encounter\",\n    \"id\": \"enc-uuid-visit-kicukiro-001\",\n    \"status\": \"in-progress\",\n    \"class\": {\n      \"system\": \"http://terminology.hl7.org/CodeSystem/v3-ActCode\",\n      \"code\": \"AMB\",\n      \"display\": \"ambulatory\"\n    },\n    \"type\": [\n      {\n        \"coding\": [\n          {\n            \"system\": \"http://openphc.org/encounter-types\",\n            \"code\": \"VISIT_ENCOUNTER\",\n            \"display\": \"Visit Encounter\"\n          }\n        ]\n      }\n    ],\n    \"subject\": {\n      \"reference\": \"Patient/{{patientUpid}}\",\n      \"display\": \"Marie-Claire KAYITESI\"\n    },\n    \"period\": {\n      \"start\": \"2026-02-25T08:00:00Z\"\n    },\n    \"location\": [\n      {\n        \"location\": {\n          \"reference\": \"Location/kicukiro-hc-uuid\",\n          \"display\": \"Kicukiro Health Center\"\n        },\n        \"status\": \"active\"\n      }\n    ]\n  }\n}"
            }
          },
          "response": []
        },
        {
          "name": "Ingest Observation (Vital Signs — Blood Pressure)",
