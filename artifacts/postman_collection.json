    {
      "name": "Dead Letter Management",
      "description": "Query and manage dead-lettered events.",
      "item": [
        {
          "name": "List Dead Letters",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/dead-letters?page=0&size=20",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "dead-letters"],
              "query": [
                {
                  "key": "page",
                  "value": "0",
                  "description": "Page number (zero-based)"
                },
                {
                  "key": "size",
                  "value": "20",
                  "description": "Page size"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get Dead Letter by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/dead-letters/{{deadLetterId}}",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "dead-letters", "{{deadLetterId}}"]
            },
            "description": "Set the `deadLetterId` collection variable to a UUID from the list response."
          },
          "response": []
        },
        {
          "name": "Retry Dead Letter",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/dead-letters/{{deadLetterId}}/retry",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "dead-letters", "{{deadLetterId}}", "retry"]
            },
            "description": "Re-process a dead-lettered event. Set `deadLetterId` first."
          },
          "response": []
        }
      ]
    },
