        {
          "name": "Ingest Event — Invalid Envelope (Missing subject)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/events",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "events"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"specversion\": \"1.0\",\n  \"id\": \"evt-invalid-no-subject-001\",\n  \"source\": \"rhie-mediator\",\n  \"type\": \"org.openphc.cce.encounter\",\n  \"datacontenttype\": \"application/fhir+json\",\n  \"data\": {\n    \"resourceType\": \"Encounter\",\n    \"id\": \"enc-invalid-001\",\n    \"status\": \"finished\",\n    \"class\": {\n      \"system\": \"http://terminology.hl7.org/CodeSystem/v3-ActCode\",\n      \"code\": \"AMB\"\n    }\n  }\n}"
            },
            "description": "Missing required `subject` field. Should return 400 with VALIDATION_ERROR and be dead-lettered with reason MISSING_SUBJECT or INVALID_ENVELOPE."
          },
          "response": []
        },
        {
          "name": "Ingest Event — Invalid FHIR Payload",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/events",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "events"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"specversion\": \"1.0\",\n  \"id\": \"evt-invalid-fhir-001\",\n  \"source\": \"rhie-mediator\",\n  \"type\": \"org.openphc.cce.encounter\",\n  \"subject\": \"{{patientUpid}}\",\n  \"time\": \"2026-02-25T11:00:00Z\",\n  \"datacontenttype\": \"application/fhir+json\",\n  \"facilityid\": \"{{facilityId}}\",\n  \"data\": {\n    \"not_a_resource\": true,\n    \"random_field\": \"this is not a valid FHIR resource\"\n  }\n}"
            },
            "description": "Data payload is not a valid FHIR R4 resource (missing resourceType). Should return 422 with FHIR_VALIDATION_ERROR and be dead-lettered with reason INVALID_FHIR."
          },
          "response": []
        },
        {
          "name": "Ingest Event — Minimal (Auto-fill Defaults)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/events",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "events"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"specversion\": \"1.0\",\n  \"id\": \"evt-minimal-001\",\n  \"source\": \"direct-emr-push\",\n  \"type\": \"cce.observation.updated\",\n  \"subject\": \"{{patientUpid}}\",\n  \"data\": {\n    \"resourceType\": \"Observation\",\n    \"id\": \"obs-minimal-001\",\n    \"status\": \"final\",\n    \"code\": {\n      \"coding\": [\n        {\n          \"system\": \"http://loinc.org\",\n          \"code\": \"8310-5\",\n          \"display\": \"Body temperature\"\n        }\n      ]\n    },\n    \"subject\": {\n      \"reference\": \"Patient/{{patientUpid}}\"\n    },\n    \"valueQuantity\": {\n      \"value\": 37.2,\n      \"unit\": \"°C\"\n    }\n  }\n}"
            },
            "description": "Minimal request — no time, correlationid, facilityid, datacontenttype. Server should auto-fill: time=received_at, correlationid=corr-<uuid>, datacontenttype=application/fhir+json. Type `cce.observation.updated` should normalize to `org.openphc.cce.observation`."
          },
          "response": []
        }
      ]
