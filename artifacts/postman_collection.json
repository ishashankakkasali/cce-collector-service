        {
          "name": "Ingest Event — cce.*.created Type (Normalization Test)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/events",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "events"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"specversion\": \"1.0\",\n  \"id\": \"evt-norm-test-001\",\n  \"source\": \"smartcare-emr\",\n  \"type\": \"cce.encounter.created\",\n  \"subject\": \"{{patientUpid}}\",\n  \"time\": \"2026-02-25T10:00:00Z\",\n  \"datacontenttype\": \"application/fhir+json\",\n  \"facilityid\": \"{{facilityId}}\",\n  \"data\": {\n    \"resourceType\": \"Encounter\",\n    \"id\": \"enc-norm-test-001\",\n    \"status\": \"finished\",\n    \"class\": {\n      \"system\": \"http://terminology.hl7.org/CodeSystem/v3-ActCode\",\n      \"code\": \"AMB\",\n      \"display\": \"ambulatory\"\n    },\n    \"subject\": {\n      \"reference\": \"Patient/{{patientUpid}}\"\n    },\n    \"period\": {\n      \"start\": \"2026-02-25T10:00:00Z\",\n      \"end\": \"2026-02-25T10:30:00Z\"\n    }\n  }\n}"
            },
            "description": "Tests event type normalization: `cce.encounter.created` should be normalized to `org.openphc.cce.encounter`. The correlationid is absent — the server should generate one with `corr-` prefix."
          },
          "response": []
        },
        {
          "name": "Ingest Event — Duplicate (Idempotency Test)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/events",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "events"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"specversion\": \"1.0\",\n  \"id\": \"evt-eb010001-0001-4000-8000-000000000001\",\n  \"source\": \"rhie-mediator\",\n  \"type\": \"org.openphc.cce.encounter\",\n  \"subject\": \"{{patientUpid}}\",\n  \"time\": \"2026-02-25T08:00:00Z\",\n  \"datacontenttype\": \"application/fhir+json\",\n  \"facilityid\": \"{{facilityId}}\",\n  \"data\": {\n    \"resourceType\": \"Encounter\",\n    \"id\": \"enc-uuid-visit-kicukiro-001\",\n    \"status\": \"in-progress\",\n    \"class\": {\n      \"system\": \"http://terminology.hl7.org/CodeSystem/v3-ActCode\",\n      \"code\": \"AMB\"\n    },\n    \"subject\": {\n      \"reference\": \"Patient/{{patientUpid}}\"\n    }\n  }\n}"
            },
            "description": "Sends the same event ID + source as the first Encounter request. Should return 200 with status: 'duplicate' (idempotent)."
          },
          "response": []
